# Copy to .env and edit. Do not commit .env.

APP_NAME=Minoto API
DEBUG=false
API_V1_PREFIX=/api/v1

# Browsers only — comma-separated dev URLs (optional to change)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Postgres (replace USER, PASSWORD, HOST, DB_NAME)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DB_NAME
