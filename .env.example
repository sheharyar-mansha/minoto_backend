# Copy to .env — never commit .env

APP_NAME=Minoto API
DEBUG=false
API_V1_PREFIX=/api/v1

# Comma-separated browser dev origins (Vite default: 5173). Add your web app origin in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Recommended for local full-stack dev: PostgreSQL (create an empty DB first, e.g. minoto_dev).
# Replace USER, PASSWORD, host/port/DB name as needed.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/minoto_dev

# SQLite (no PostgreSQL): comment the line above and use:
# DATABASE_URL=sqlite:///./minoto.db

# JWT (optional in dev — insecure default in code if unset). Set a long random string in production.
# SECRET_KEY=change-me-to-a-long-random-string

# Uploaded voice / avatars (folder under backend/)
UPLOAD_ROOT=uploads
MAX_VOICE_UPLOAD_MB=25

# --- Pipeline v2 (transcription + speaker matching + minutes) ---
# ffmpeg is bundled via imageio-ffmpeg (pip). System ffmpeg on PATH is also fine.

# Hugging Face token — accept model terms at https://huggingface.co/pyannote/embedding
PYANNOTE_AUTH_TOKEN=

# Google Gemini — required for structured meeting minutes (transcript still completes without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ASR / embeddings (torch is installed from requirements.txt; see requirements-gpu.txt for NVIDIA CUDA)
TRANSCRIBE_MODEL_SIZE=small
TRANSCRIBE_DEVICE=cpu
TRANSCRIBE_COMPUTE_TYPE=int8
ASR_BACKEND=faster_whisper
EMBEDDING_BACKEND=pyannote
ENABLE_SPEAKER_MATCHING=true
