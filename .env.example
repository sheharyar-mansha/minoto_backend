# Copy to .env — never commit .env

APP_NAME=Minoto API
DEBUG=false
API_V1_PREFIX=/api/v1

# Comma-separated browser dev origins (mobile ignores CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local SQLite (default). For Postgres:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/minoto
DATABASE_URL=sqlite:///./minoto.db

# Uploaded voice / avatars (folder under backend/)
UPLOAD_ROOT=uploads
MAX_VOICE_UPLOAD_MB=25
